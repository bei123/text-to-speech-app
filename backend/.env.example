# Redis 配置
REDIS_URL=redis://localhost:6379
REDIS_DB=1

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# 数据库配置
DB_HOST=127.0.0.1
DB_USER=text_to_speech
DB_PASSWORD=
DB_NAME=text_to_speech 
REDIS_URL=redis://localhost:6379
REDIS_DB=1

# JWT 密钥
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# TTS api配置（普通语音）
SPEECH_API_URL=http://autodl.2000gallery.art:44344

# v2ProPlus 参考音频语音（自定义音色）
V2PROPLUS_API_URL=http://autodl.2000gallery.art:11085/v2proplus

# 服务端口（HTTP，暂不启用 SSL）
PORT=5000

# 前端 API 签名校验（与 .env.production 中 VUE_APP_CLIENT_SIGN_SECRET 相同；留空则关闭）
CLIENT_SIGN_SECRET=

# 限流：15 分钟内每 IP 最大请求数 / 1 小时内语音生成次数
RATE_LIMIT_MAX=300
RATE_LIMIT_SPEECH_MAX=30